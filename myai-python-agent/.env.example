MYAI_LLM_PROVIDER=stub
MYAI_CHAT_PROVIDER=stub
MYAI_TASK_PROVIDER=stub
MYAI_MEMORY_PROVIDER=stub
MYAI_EMBEDDING_PROVIDER=stub
MYAI_CHAT_MODEL_ID=
MYAI_TASK_MODEL_ID=
MYAI_MEMORY_MODEL_ID=
MYAI_EMBEDDING_MODEL_ID=
MYAI_MEMORY_LLM_EXTRACTOR_ENABLED=false
MYAI_LLM_TEMPERATURE=0.7
# Applies to text generation only. Real embedding providers always fail closed;
# use MYAI_EMBEDDING_PROVIDER=stub explicitly for a disposable Stub index.
MYAI_LLM_FALLBACK_TO_STUB=true
MYAI_MODEL_TRUST_ENV_PROXY=false
MYAI_LLM_REQUEST_TIMEOUT_SECONDS=3
MYAI_LLM_MAX_RETRIES=0
MYAI_LLM_SEED=42
MYAI_LLM_MAX_TOKENS=512
MYAI_EMBEDDING_REQUEST_TIMEOUT_SECONDS=3
MYAI_EMBEDDING_MAX_RETRIES=0
MYAI_EMBEDDING_EXPECTED_DIMENSIONS=0

# Generic local OpenAI-compatible server (for example Ollama, vLLM, or LM Studio).
# The default is loopback-only. Set provider values above to openai_compatible.
MYAI_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
MYAI_OPENAI_COMPATIBLE_API_KEY=
# Leave blank to reuse MYAI_OPENAI_COMPATIBLE_BASE_URL / API_KEY.
MYAI_OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=
MYAI_OPENAI_COMPATIBLE_EMBEDDING_API_KEY=

# Runtime persistence. Use ephemeral mode only for isolated tests/evaluation.
MYAI_CHROMA_MODE=persistent
MYAI_CHROMA_DIR=./chroma_db
MYAI_KNOWLEDGE_DATA_DIR=./knowledge_data
MYAI_MEMORY_SETTINGS_DIR=./memory_settings
MYAI_RUNTIME_DB_PATH=./.runtime/runtime.db
MYAI_RUNTIME_DB_BUSY_TIMEOUT_MS=5000

# Unified runtime resilience and asynchronous memory maintenance.
MYAI_MEMORY_MAINTENANCE_ENABLED=true
MYAI_MEMORY_MAINTENANCE_DEBOUNCE_SECONDS=30
MYAI_MEMORY_MAINTENANCE_IDLE_POLL_SECONDS=1
MYAI_MEMORY_MAINTENANCE_MAX_USERS=10000
MYAI_MEMORY_MAINTENANCE_WORKER_COUNT=2
MYAI_MEMORY_MAINTENANCE_DEADLINE_SECONDS=60
MYAI_MEMORY_MAINTENANCE_SHUTDOWN_TIMEOUT_SECONDS=5
MYAI_CIRCUIT_FAILURE_THRESHOLD=3
MYAI_CIRCUIT_RECOVERY_SECONDS=30
MYAI_RETRY_BASE_DELAY_SECONDS=0.25
MYAI_RETRY_MAX_DELAY_SECONDS=2
MYAI_RETRY_JITTER_RATIO=0.2
MYAI_TASK_MAX_PENDING_RUNS=100
MYAI_TASK_SHUTDOWN_TIMEOUT_SECONDS=5
MYAI_CHAT_DEADLINE_SECONDS=150
MYAI_TASK_DEADLINE_SECONDS=120

# Local filesystem access is disabled unless explicitly opted in.
# At least one narrow root is required when enabled (separate multiple roots with the OS path separator).
MYAI_MCP_FILESYSTEM_ENABLED=false
MYAI_MCP_FILESYSTEM_ROOTS=

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID=
ARK_EMBEDDING_MODEL_ID=
