# MyAI portable local configuration.
# setup.cmd copies this file to app.env and creates a random local password.
# Do not copy secrets into app.env.example.

PYTHON_PORT=8000
JAVA_PORT=8080

# The distributable starts safely without a model server. Change these values
# after installing Ollama or another OpenAI-compatible local provider.
MYAI_LLM_PROVIDER=stub
MYAI_CHAT_PROVIDER=stub
MYAI_TASK_PROVIDER=stub
MYAI_MEMORY_PROVIDER=stub
MYAI_EMBEDDING_PROVIDER=stub
MYAI_LLM_FALLBACK_TO_STUB=true

MYAI_CHAT_MODEL_ID=
MYAI_TASK_MODEL_ID=
MYAI_MEMORY_MODEL_ID=
MYAI_EMBEDDING_MODEL_ID=
MYAI_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
MYAI_OPENAI_COMPATIBLE_API_KEY=

MYAI_MEMORY_MAINTENANCE_ENABLED=true
MYAI_MCP_FILESYSTEM_ENABLED=true
MYAI_MCP_FILESYSTEM_ROOTS=
MYAI_MCP_GIT_ENABLED=false

MYAI_LOCAL_USERNAME=local-user
MYAI_LOCAL_EMAIL=local-user@myai.local
MYAI_LOCAL_PASSWORD=
